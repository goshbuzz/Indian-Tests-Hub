+          {t.sync}
+        </button>
+      </div>
+      <p className="mt-2 text-xs text-stone-500">
+        Showing {prefs.size ? "followed / saved tests" : "all synced ads"}. Save a test or tap Follow on its Jobs tab.
+      </p>
+      <ul className="mt-4 space-y-3">
+        {list.map((j, i) => {
