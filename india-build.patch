diff --git a/src/app/globals.css b/src/app/globals.css
new file mode 100644
index 0000000..99e82f6
--- /dev/null
+++ b/src/app/globals.css
@@ -0,0 +1,41 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root {
+  --background: #f4f1e8;
+  --foreground: #1c1917;
+}
+
+body {
+  color: var(--foreground);
+  background: var(--background);
+  -webkit-tap-highlight-color: transparent;
+}
+
+html {
+  height: 100%;
+}
+
+@layer utilities {
+  .text-balance {
+    text-wrap: balance;
+  }
+}
+
+/* ————— Marketing home hero: one deliberate entrance sequence (Phase 4 motion rule).
+   Static fallback via prefers-reduced-motion — never blocks content for crawlers. */
+@keyframes pth-rise {
+  from { opacity: 0; transform: translateY(14px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+.hero-rise > * { animation: pth-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
+.hero-rise > *:nth-child(2) { animation-delay: 0.08s; }
+.hero-rise > *:nth-child(3) { animation-delay: 0.16s; }
+.hero-rise > *:nth-child(4) { animation-delay: 0.24s; }
+.hero-rise > *:nth-child(5) { animation-delay: 0.32s; }
+.hero-rise-side { animation: pth-rise 0.7s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both; }
+@media (prefers-reduced-motion: reduce) {
+  .hero-rise > *,
+  .hero-rise-side { animation: none; }
+}
diff --git a/src/app/jobs/layout.tsx b/src/app/jobs/layout.tsx
new file mode 100644
index 0000000..d12ee6f
--- /dev/null
+++ b/src/app/jobs/layout.tsx
@@ -0,0 +1,21 @@
+import type { Metadata } from "next";
+import { OG_IMAGE, SITE_URL } from "@/lib/site";
+
+export const metadata: Metadata = {
+  title: { absolute: "Govt Jobs India 2026 — Railways, Banks, SSC & State Recruitment" },
+  description:
+    "Current central and state recruitment notices with posts, last date and the official apply link on every listing.",
+  alternates: { canonical: `${SITE_URL}/jobs` },
+  keywords: ["India government jobs", "RRB NTPC 2026", "TNPSC Group 4 2026", "SSC jobs 2026", "bank jobs India", "police constable jobs"],
+  openGraph: {
+    type: "website",
+    url: `${SITE_URL}/jobs`,
+    title: "Government jobs India — current ads & official apply links",
+    description: "Railway, bank, police, SSC and state PSC recruitment, each mapped to its free prep test page.",
+    images: [OG_IMAGE],
+  },
+};
+
+export default function JobsLayout({ children }: { children: React.ReactNode }) {
+  return children;
+}
diff --git a/src/app/jobs/page.tsx b/src/app/jobs/page.tsx
new file mode 100644
index 0000000..f0f5468
