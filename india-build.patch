+export type Category =
+  | "Admissions"
+  | "Admissions-Grad"
+  | "Recruitment"
+  | "PSC"
+  | "Banking"
+  | "Police"
+  | "Judicial"
+  | "Teaching"
+  | "Armed Forces"
+  | "Professional"
+  | "International";
+
+export type CareerStage =
+  | "Matric"
+  | "Intermediate"
+  | "Graduate"
+  | "Job Seeker"
+  | "Professional"
+  | "Abroad";
+
+export type Test = {
+  id: string;
+  name: string;
+  /** Hindi name shown in the Hindi interface. */
+  name_hi: string;
+  category: Category;
+  career_stage: CareerStage;
+  conducting_body: string;
+  official_url: string;
+  eligibility: string;
+  /** English pattern line (questions, marks, time, negative marking, sections). */
+  format_description: string;
+  /** Hindi pattern line. */
+  format_hi: string;
+  fee_info: string;
+  last_updated: string;
+  /** Key into `FAMILIES` (src/data/families.ts). */
+  family: string;
+  /** False = pattern is approximate; the UI says so. */
+  verified: boolean;
+  priority?: boolean;
+};
+
+export type SyllabusItem = {
+  id: string;
+  test_id: string;
+  subject: string;
+  topic: string;
+  subtopic: string;
+  weightage: number;
+};
+
+export type PastPaper = {
+  id: string;
+  test_id: string;
+  year: number;
+  conducting_body_variant: string;
+  file_url: string;
+  source: string;
+  verified: boolean;
+};
+
+export type MCQ = {
+  id: string;
+  test_id: string;
+  subject: string;
+  topic: string;
+  question_text: string;
+  options: string[];
+  correct_answer: number;
+  explanation: string;
+  difficulty: "easy" | "medium" | "hard";
+  source: "official" | "ai_generated" | "aggregator";
+  kind?: "mcq" | "short" | "long";
+  model_answer?: string;
+};
+
+export type MockConfig = {
+  id: string;
+  test_id: string;
+  time_limit_minutes: number;
+  negative_marking: boolean;
+  negative_value: number;
+  question_count: number;
+};
+
+export type Alert = {
+  id: string;
+  test_id: string;
+  type: "new_date" | "roll_slip" | "result" | "announcement";
+  title: string;
+  body: string;
+  source_url: string;
+  published_at: string;
+};
+
+export type User = {
+  id: string;
+  name: string;
+  email: string;
+  language: "en" | "hi";
+};
+
+export type MockAttempt = {
+  test_id: string;
+  score: number;
+  total: number;
+  date: string;
+  paper_year?: number;
+};
+
+export type Job = {
+  id: string;
+  test_id: string;
+  title: string;
+  organization: string;
+  location: string;
+  last_date: string;
+  apply_url: string;
+  source: string;
+  posts?: string;
+  fee?: string;
+  synced_at: string;
+};
+
+export type PrepPack = {
+  test_id: string;
+  documents: string[];
+  challan: string;
+  apply_url: string;
+  apply_label: string;
+};
