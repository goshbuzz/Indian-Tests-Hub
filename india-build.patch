+export const metadata: Metadata = {
+  title: { absolute: "Prep dashboard — Indian Tests Hub app" },
+  description:
+    "Your personal Indian Tests Hub dashboard — day streak, points, saved tests, trending mocks and fresh exam alerts. Guest-friendly; progress stays on your device.",
+  alternates: { canonical: `${SITE_URL}/start` },
+  robots: { index: false, follow: true },
+};
+
+export default function StartLayout({ children }: { children: React.ReactNode }) {
+  return children;
+}
