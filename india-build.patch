diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..e0efe06
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,83 @@
+// Bump CACHE together with LOGO_SRC in src/lib/brand.ts whenever brand artwork changes.
+// v1 (India fork): new brand artwork and manifest.
+// The old cache pinned the previous dashboard HTML — including its stale <title> and
+// canonical — which Google then re-crawled through Chrome, confusing indexing. Bumping
+// the cache name force-drops every cached page on the next load.
+const CACHE = "ith-in-v1";
+// Precache brand chrome only — NEVER "/" or app pages. HTML must stay network-first
+// (see the navigate branch below) so crawlers and users always see fresh content.
+const CORE = ["/logo.png?v=6", "/manifest.json"];
+
+// Brand assets must never be pinned in the cache: a deploy that swaps the logo or an
+// icon has to reach returning visitors and installed PWAs on their next load. These are
+// served network-first with a cache fallback — always fresh online, still available
+// offline. Everything else stays cache-first for offline navigation.
+const REVALIDATE = /\/(logo\.png|icon-\d+\.png|apple-touch-icon\.png|favicon\.ico|manifest\.json)$/;
+
+function putInCache(request, response) {
+  if (!response || !response.ok) return;
+  const copy = response.clone();
+  caches.open(CACHE).then((c) => c.put(request, copy));
+}
+
+self.addEventListener("install", (e) => {
+  e.waitUntil(caches.open(CACHE).then((c) => c.addAll(CORE)).then(() => self.skipWaiting()));
+});
+
+self.addEventListener("activate", (e) => {
+  e.waitUntil(
+    caches.keys().then((keys) => Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k)))).then(() => self.clients.claim())
+  );
+});
+
+self.addEventListener("fetch", (e) => {
+  const url = new URL(e.request.url);
+  if (e.request.method !== "GET" || url.origin !== location.origin) return;
+
+  if (REVALIDATE.test(url.pathname)) {
+    e.respondWith(
+      fetch(e.request)
+        .then((res) => {
+          putInCache(e.request, res);
+          return res;
+        })
+        .catch(() => caches.match(e.request))
+    );
+    return;
+  }
+
+  // Page navigations = network-first. Fresh HTML for Google (indexing depends on the
+  // <title>/canonical/robots a crawl actually receives) and for users after each
+  // deploy; the cache is only the offline fallback, never the primary answer.
+  const isHtml =
+    e.request.mode === "navigate" || (e.request.headers.get("accept") || "").includes("text/html");
+  if (isHtml) {
+    e.respondWith(
+      fetch(e.request)
+        .then((res) => {
+          putInCache(e.request, res);
+          return res;
+        })
+        .catch(() => caches.match(e.request))
+    );
+    return;
+  }
+
+  // Everything else (fonts, images, hashed static chunks) stays cache-first.
+  e.respondWith(
+    caches.match(e.request).then((hit) => {
+      const net = fetch(e.request)
+        .then((res) => {
+          putInCache(e.request, res);
+          return res;
+        })
+        .catch(() => hit);
+      return hit || net;
+    })
+  );
+});
+
+self.addEventListener("notificationclick", (e) => {
+  e.notification.close();
+  e.waitUntil(self.clients.openWindow(e.notification.data?.url || "/alerts"));
+});
diff --git a/scripts/check-seo.mts b/scripts/check-seo.mts
new file mode 100644
index 0000000..cc9dbb6
--- /dev/null
+++ b/scripts/check-seo.mts
@@ -0,0 +1,144 @@
+/**
+ * SEO / page-identity regression harness (Master Prompt Phases 5–6 + 9).
+ * Run after `npm run build`:  npx tsx scripts/check-seo.mts
+ *
+ * Parses the prerendered HTML in .next/server/app and asserts, with evidence:
+ *   1. every indexable page has a title; titles are unique site-wide
+ *   2. title length ≤ 65 chars, description ≤ 175 chars (SERP-friendly)
+ *   3. every indexable page carries its OWN canonical matching its route
+ *   4. exactly the app-only routes carry meta robots noindex
+ *   5. every main page ships its own FAQPage JSON-LD (page-relevant FAQ)
+ *   6. every main page has an og:image pointing at the 1424×752 brand cover
+ *   7. exactly one <h1> per main page
+ *   8. the marketing home links into the app (/start) with a CTA
+ *   9. sitemap.xml (runtime) — verified separately by the checks below when dev server is up; here we check the module
+ * Exits 1 on any FAIL.
+ */
+import { readFileSync, readdirSync, existsSync } from "node:fs";
+import { join } from "node:path";
+
+const APP_DIR = ".next/server/app";
+
+type Expectation = { file: string; route: string; index: boolean };
+
+const MAIN: Expectation[] = [
+  { file: "index.html", route: "/", index: true },
+  { file: "start.html", route: "/start", index: false },
+  { file: "explore.html", route: "/explore", index: true },
+  { file: "jobs.html", route: "/jobs", index: true },
+  { file: "alerts.html", route: "/alerts", index: true },
+  { file: "faq.html", route: "/faq", index: true },
+  { file: "about.html", route: "/about", index: true },
+  { file: "contact.html", route: "/contact", index: true },
+  { file: "privacy.html", route: "/privacy", index: true },
+  { file: "terms.html", route: "/terms", index: true },
+  { file: "login.html", route: "/login", index: false },
+  { file: "profile.html", route: "/profile", index: false },
+  { file: "leaderboard.html", route: "/leaderboard", index: false },
+];
+
+let failures = 0;
+const fail = (m: string) => {
+  failures++;
+  console.error(`  ✗ ${m}`);
+};
+const pass = (m: string) => console.log(`  ✓ ${m}`);
+
+function read(file: string): string {
+  const p = join(APP_DIR, file);
+  if (!existsSync(p)) return "";
+  return readFileSync(p, "utf8");
+}
+
+const meta = (html: string, re: RegExp) => html.match(re)?.[1] ?? "";
+const unesc = (s: string) => s.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#x27;/g, "'");
+
+console.log("check-seo: verifying prerendered HTML identity rules\n");
+
+/* 1–3, 5–8: main pages */
+const titles = new Map<string, string>();
+for (const { file, route, index } of MAIN) {
+  const html = read(file);
+  if (!html) {
+    fail(`${route}: prerendered HTML missing (${file}) — did the build run?`);
+    continue;
+  }
+  const title = unesc(meta(html, /<title>([^<]*)<\/title>/));
+  if (!title) fail(`${route}: no <title>`);
+  else {
+    if (index && title.length > 65) fail(`${route}: title ${title.length} chars (≤65 wanted): “${title}”`);
+    const prev = titles.get(title);
+    if (prev) fail(`${route}: title duplicated from ${prev}`);
+    titles.set(title, route);
+  }
+  const desc = unesc(meta(html, /name="description" content="([^"]*)"/));
+  if (!desc) fail(`${route}: no meta description`);
+  else if (index && desc.length > 175) fail(`${route}: description ${desc.length} chars (≤175 wanted)`);
+
+  const canonical = meta(html, /rel="canonical" href="([^"]*)"/);
+  if (index) {
+    const want = route === "/" ? "/" : route;
+    if (!canonical) fail(`${route}: missing canonical (stray noindex or dup risk)`);
+    else if (!canonical.replace(/\/$/, "") .endsWith(want.replace(/^\//, "").replace(/^$/, "")) && !canonical.endsWith(want))
+      fail(`${route}: canonical “${canonical}” does not point at its own route`);
+    else pass(`${route}: canonical ok — ${canonical}`);
+    if (/noindex/.test(html)) fail(`${route}: indexable page carries a stray noindex!`);
+  } else {
+    if (!/name="robots" content="[^"]*noindex/.test(html)) fail(`${route}: expected noindex (app-only screen)`);
+    else pass(`${route}: noindex ok`);
+  }
+
+  if (index) {
+    if (!/"@type":"FAQPage"/.test(html)) fail(`${route}: no FAQPage JSON-LD block (Phase 6 violation)`);
+    else pass(`${route}: own FAQPage schema`);
+    const ogImage = meta(html, /property="og:image" content="([^"]*)"/);
+    if (!/og-cover\.png/.test(ogImage)) fail(`${route}: og:image missing or not the brand cover (got “${ogImage}”)`);
+    else pass(`${route}: og:image cover ok`);
+    const h1s = (html.match(/<h1[ >]/g) ?? []).length;
+    if (h1s !== 1) fail(`${route}: ${h1s} <h1> tags (want exactly 1)`);
+  }
+}
+
+/* 8: home CTA into the app */
+{
+  const home = read("index.html");
+  const ctas = (home.match(/href="\/start"/g) ?? []).length;
+  if (ctas < 3) fail(`home: only ${ctas} links to /start — CTAs into the app expected (≥3)`);
+  else pass(`home: ${ctas} CTAs into the app at /start`);
+  if (!/Open the free test hub/.test(home)) fail("home: hero CTA copy 'Open the free test hub' not found");
+}
+
+/* 4: noindex set is exactly right — sweep every prerendered page */
+function walk(dir: string): string[] {
+  const out: string[] = [];
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, e.name);
+    if (e.isDirectory()) out.push(...walk(p));
+    else if (e.name.endsWith(".html")) out.push(p);
+  }
+  return out;
+}
+const EXPECTED_NOINDEX_FILES = new Set(["start", "login", "profile", "leaderboard"]);
+for (const file of walk(APP_DIR)) {
+  const rel = file.slice(APP_DIR.length + 1).replace(/\.html$/, "");
+  if (rel.includes("_not-found") || rel.startsWith("api")) continue;
+  const html = readFileSync(file, "utf8");
+  const noindex = /name="robots" content="[^"]*noindex/.test(html);
+  const isTestPage = rel.startsWith("tests/");
+  const isMain = MAIN.some((m) => m.file.endsWith(`${rel}.html`) || rel === "index");
+  if (!isMain && !isTestPage) continue; // only police known page families
+  if (isTestPage && noindex) fail(`${rel}: test content page must stay indexable`);
+  if (!isTestPage) {
+    const want = EXPECTED_NOINDEX_FILES.has(rel);
+    if (noindex !== want) fail(`${rel}: noindex=${noindex} but expected ${want}`);
+  }
+}
+
+/* 9: sitemap module content */
+{
+  const sm = read("sitemap.xml/sitemap.xml") || "";
+  if (sm.includes("/start")) fail("sitemap includes /start (must list indexable pages only)");
+}
+
+console.log(failures === 0 ? "\ncheck-seo: PASS — all identity rules hold." : `\ncheck-seo: FAIL — ${failures} issue(s) above.`);
+process.exit(failures === 0 ? 0 : 1);
diff --git a/scripts/verify-banks.mts b/scripts/verify-banks.mts
new file mode 100644
index 0000000..f1a0120
--- /dev/null
+++ b/scripts/verify-banks.mts
@@ -0,0 +1,73 @@
+import { TESTS } from "../src/data/tests.ts";
+import { mcqsFor, questionsForPaper, prepPackFor } from "../src/data/coverage.ts";
+import { bankSubjectFor } from "../src/data/mcqBank.ts";
+import { paperShape, slotCount } from "../src/data/mockShape.ts";
+import { subjectsFor } from "../src/data/sections.ts";
+
+function matchesSubject(subject: string, allowed: string[]): boolean {
+  const s = subject.toLowerCase();
+  return allowed.some((a) => a.toLowerCase() === s);
+}
+import { applyUrl } from "../src/data/applyUrls.ts";
+import { patternFor } from "../src/data/patterns.ts";
+import { guidesFor } from "../src/data/studyGuides.ts";
+
+const ALL_MCQS = TESTS.flatMap((t) => mcqsFor(t.id));
+
+const issues: string[] = [];
+
+function add(msg: string) {
+  issues.push(msg);
+}
+
+const FORBIDDEN: Record<string, string[]> = {
+  International: ["pakistan studies", "islamiat", "biology", "banking gk", "gk"],
+  Admissions: ["german", "ielts"],
+};
+
+for (const t of TESTS) {
+  const allowed = subjectsFor(t.id, t.category).flatMap((x) => bankSubjectFor(x));
+  const bank = ALL_MCQS.filter((m) => m.test_id === t.id);
+  const leak = bank.filter((m) => !matchesSubject(m.subject, allowed));
+  if (leak.length) add(`${t.id} LEAK ${leak[0].subject} :: ${leak[0].question_text.slice(0, 50)}`);
+
+  const mcq = bank.filter((m) => (m.kind ?? "mcq") === "mcq");
+  const badKey = mcq.filter((m) => m.correct_answer < 0 || m.correct_answer >= m.options.length || m.options.length < 2);
+  if (badKey.length) add(`${t.id} BAD_KEY ${badKey[0].question_text.slice(0, 50)}`);
+
+  const dup = new Map<string, number>();
+  for (const m of bank) dup.set(m.question_text, (dup.get(m.question_text) ?? 0) + 1);
+  const dups = [...dup.entries()].filter(([, n]) => n > 3);
+  if (dups.length) add(`${t.id} HEAVY_DUP ${dups[0][0].slice(0, 40)}`);
+
+  if (t.category === "International" && bank.some((m) => /pakistan studies|islamiat/i.test(m.subject))) {
+    add(`${t.id} INTL_CIVICS`);
+  }
+
+  const shape = paperShape(t.id, t.category);
+  const paper = questionsForPaper(t.id, 2025, 1, "verify");
+  if (paper.length < Math.ceil(slotCount(shape) * 0.7)) {
+    add(`${t.id} THIN_PAPER ${paper.length}/${slotCount(shape)}`);
+  }
+  const paperLeak = paper.filter((m) => !matchesSubject(m.subject, allowed));
+  if (paperLeak.length) add(`${t.id} PAPER_LEAK ${paperLeak[0].subject}`);
+
+  for (const sl of shape.slots) {
+    if (sl.kind !== "mcq" || !sl.subject) continue;
+    const n = paper.filter((p) => (p.kind ?? "mcq") === "mcq" && matchesSubject(p.subject, bankSubjectFor(sl.subject!))).length;
+    if (n === 0) add(`${t.id} EMPTY_SLOT ${sl.subject}`);
+  }
+
+  if (!applyUrl(t.id, TESTS.find((x) => x.id === t.id)!.official_url ?? "")) add(`${t.id} NO_APPLY_URL`);
+  if (!patternFor(t.id)) add(`${t.id} NO_PATTERN`);
+  if (!prepPackFor(t.id)) add(`${t.id} NO_PACK`);
+  if (bank.length < 8) add(`${t.id} SMALL_BANK ${bank.length}`);
+}
+
+const missingGuide = TESTS.filter((t) => t.priority && guidesFor(t.id).length === 0);
+for (const t of missingGuide) add(`${t.id} PRIORITY_NO_GUIDE`);
+
+console.log("tests", TESTS.length, "mcqs", ALL_MCQS.length);
+console.log("ISSUES", issues.length);
+console.log(issues.join("\n") || "none");
+if (issues.length) process.exitCode = 1;
